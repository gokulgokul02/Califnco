# ============================================================
# Califnco Admin — Firebase Web Config (Vite env file)
# ============================================================
# Copy this file to .env.local and fill in values from your
# Firebase Project Settings → Your apps → Web app config.
# These variables are REQUIRED to connect the admin panel to
# your live Firestore database. They are safe to add to Vercel
# Environment Variables (they are web-public client keys).
# NEVER commit your .env.local file to git.
# ============================================================

VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:your_app_id_here
