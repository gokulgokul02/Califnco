# ============================================================
# Califnco n8n Automation — Environment Variables
# ============================================================
# Copy this file to .env and fill in all values.
# Then start n8n with: docker compose up -d
# ============================================================

# ---- n8n Core (REQUIRED) ----
# Generate a strong 32-character random string for encryption:
# On Windows PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | % {[char]$_})
N8N_ENCRYPTION_KEY=change_this_to_a_32char_random_key

# ---- n8n Variables (set these in n8n UI under Settings → Variables) ----
# The following are referenced as $vars.VARNAME inside n8n workflow nodes.
# After n8n starts, go to: http://localhost:5678 → Settings → Variables → Add

# Google Sheets document ID (from the URL of your product catalog sheet)
# e.g. https://docs.google.com/spreadsheets/d/THIS_PART/edit
# GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Gemini API Key (free tier — 15 RPM — from ai.google.dev)
# GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face API Token (free — from huggingface.co/settings/tokens)
# HF_API_TOKEN=hf_your_token_here

# ImgBB API Key (free — from api.imgbb.com)
# IMGBB_API_KEY=your_imgbb_api_key_here

# Meta Graph API — Instagram Graph API
# IG_USER_ID: Your Instagram Business / Creator account ID
# META_ACCESS_TOKEN: Long-lived Page access token from developers.facebook.com
# IG_USER_ID=your_instagram_user_id_here
# META_ACCESS_TOKEN=your_meta_long_lived_token_here
